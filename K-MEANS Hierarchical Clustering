# ============================================
# K-Means, Hierarchical Clustering, and PCA
# Kaggle Mall Customers Dataset
# ============================================

# 1. Import libraries
import pandas as pd
import matplotlib.pyplot as plt

from google.colab import drive

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.cluster import AgglomerativeClustering
from sklearn.decomposition import PCA


# ============================================
# 2. Mount Google Drive
# ============================================

drive.mount('/content/drive')


# ============================================
# 3. Read the Kaggle dataset
# ============================================


file_path = "/content/drive/My Drive/datasets/Country-data.csv"


df = pd.read_csv(file_path)

print("First 5 rows:")
print(df.head())


# ============================================
# 4. Select features
# ============================================

X = df[
    [
        'child_mort',
        'exports',
        'health',
        'imports',
        'income',
        'inflation',
        'life_expec',
        'total_fer',
        'gdpp'
    ]
]

print("\nSelected Features:")
print(X.head())


# ============================================
# 5. Standardize the data
# ============================================

scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)


# ============================================
# 6. K-MEANS CLUSTERING
# ============================================

kmeans = KMeans(
    n_clusters=5,
    random_state=42,
    n_init=10
)

df['KMeans_Cluster'] = kmeans.fit_predict(X_scaled)


print("\nK-Means Results:")
print(df[
    [
        'income',
        'total_fer',
        'gdpp',
        'KMeans_Cluster'
    ]
].head(10))


# ============================================
# 7. Plot K-Means
# ============================================

plt.figure(figsize=(8, 6))

plt.scatter(
    df['income'],
    df['gdpp'],
    c=df['KMeans_Cluster']
)

plt.xlabel('Income per Person')
plt.ylabel('GDP per Capita')
plt.title('K-Means Customer Clusters')

plt.show()


# ============================================
# 8. HIERARCHICAL CLUSTERING
# ============================================

hierarchical = AgglomerativeClustering(
    n_clusters=5
)

df['Hierarchical_Cluster'] = hierarchical.fit_predict(
    X_scaled
)


print("\nHierarchical Clustering Results:")
print(df[
    [
        'income',
        'total_fer',
        'gdpp',
        'Hierarchical_Cluster'
    ]
].head(10))


# ============================================
# 9. Plot Hierarchical Clustering
# ============================================

plt.figure(figsize=(8, 6))

plt.scatter(
    df['income'],
    df['gdpp'],
    c=df['Hierarchical_Cluster']
)

plt.xlabel('Income per Person')
plt.ylabel('GDP per Capita')
plt.title('Hierarchical Customer Clusters')

plt.show()


# ============================================
# 10. PCA
# ============================================

pca = PCA(n_components=2)

X_pca = pca.fit_transform(X_scaled)


# Add PCA results to DataFrame
df['PC1'] = X_pca[:, 0]
df['PC2'] = X_pca[:, 1]


# ============================================
# 11. Explained Variance
# ============================================

print("\nExplained Variance:")
print(pca.explained_variance_ratio_)

print("\nTotal Variance Explained:")
print(pca.explained_variance_ratio_.sum())


# ============================================
# 12. Plot PCA
# ============================================

plt.figure(figsize=(8, 6))

plt.scatter(
    df['PC1'],
    df['PC2'],
    c=df['KMeans_Cluster']
)

plt.xlabel('Principal Component 1')
plt.ylabel('Principal Component 2')
plt.title('PCA Visualization of Country Data')

plt.show()

